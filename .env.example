# Plantilla de configuración de NSPBX.
#
#   cp .env.example .env      (y después completar los secretos)
#
# Sin un .env con al menos FS_ESL_PASSWORD y FS_XML_SECRET, `docker
# compose up` NO arranca: esas dos están declaradas con "?" en el
# docker-compose.yml justamente para fallar de entrada con un mensaje
# claro, en vez de levantar una central con la contraseña de fábrica.
#
# Para generar cada secreto (uno distinto por variable):
#   openssl rand -base64 32
# o, si no hay openssl a mano:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Base de datos -------------------------------------------------
# OBLIGATORIAS. No hay contraseña de fábrica: si quedan vacías el compose se
# niega a arrancar. `bash scripts/setup.sh` las genera al azar; a mano, usa
# algo largo (`openssl rand -base64 32`).
POSTGRES_USER=nspbx
POSTGRES_PASSWORD=
POSTGRES_DB=nspbx

# Contraseña del rol `nspbx_app`, con el que la aplicación atiende la
# operación normal. El backend crea el rol solo al arrancar; acá va
# únicamente la contraseña.
#
# No es un detalle administrativo. El usuario de arriba es DUEÑO de las
# tablas y además superusuario —así lo crea la imagen de Postgres— y un
# superusuario se saltea las políticas de aislamiento SIEMPRE, incluso
# con FORCE ROW LEVEL SECURITY. Si la aplicación se conectara con él,
# cada empresa podría ver los datos de las demás y nada lo delataría: ni
# un error, ni una línea en el log.
#
# OBLIGATORIA. Antes, vacía significaba "arranca igual y NO aísla nada",
# un fallo silencioso; ahora el compose se niega a arrancar sin ella.
POSTGRES_APP_PASSWORD=

# --- OBLIGATORIAS: sin esto el compose se niega a arrancar ----------
# Contraseña del Event Socket de FreeSWITCH (ESL). Es el socket que
# permite originar llamadas y ejecutar comandos: con la de fábrica
# ("ClueCon") es el vector de fraude telefónico más buscado por los
# escáneres automáticos. Tiene que coincidir con la de
# freeswitch/conf/autoload_configs/event_socket.conf.xml.
FS_ESL_PASSWORD=

# Secreto compartido de los endpoints que FreeSWITCH consulta al backend
# (/fs/directory, /fs/dialplan y /fs/cdr). Sin él, cualquiera que
# alcance el puerto del backend podría leer las contraseñas SIP de todas
# las extensiones o inyectar llamadas falsas en el historial.
# OJO: este valor está repetido en DOS archivos de configuración de
# FreeSWITCH y hay que cambiarlo en los tres lugares a la vez:
#   - freeswitch/conf/autoload_configs/xml_curl.conf.xml
#   - freeswitch/conf/autoload_configs/json_cdr.conf.xml
FS_XML_SECRET=

# --- Publicación en internet ----------------------------------------
# Este stack NO trae su propio Traefik: se engancha al que ya corre en
# el servidor (el de Dokploy), a través de la red externa
# `traefik-public`. Dos Traefik peleando por los puertos 80 y 443
# terminan con uno reiniciándose en loop.
#
# Subdominio por el que se entra al panel. El MISMO atiende la API
# (/api, /ws) y el softphone (/sip): un solo certificado, sin CORS.
#
# En el DNS tiene que ser un registro A apuntando a la IP pública del
# servidor, y en Cloudflare en modo "solo DNS" (nube GRIS): con el
# proxy naranja, Let's Encrypt no puede validar el dominio por HTTP-01
# y además el WebSocket del softphone pasaría por un intermediario que
# le agrega latencia a la señalización de voz.
PBX_HOST=pbx.tudominio.com

# Nombre del certificatesResolver TAL COMO está definido en el Traefik
# del servidor (en su compose, `--certificatesresolvers.NOMBRE.acme...`).
# Si no coincide exactamente, Traefik no emite certificado y el sitio
# queda sirviendo el cert por defecto, que el navegador rechaza.
ACME_RESOLVER=mi-resuelves-ssl

# --- Relay de audio del softphone (TURN) ---------------------------
# El audio del navegador viaja por UDP directo al contenedor de
# FreeSWITCH. Muchas redes solo dejan salir 80 y 443 —oficinas de
# clientes, hoteles, datos móviles, y redes corporativas con el firewall
# cerrado— y ahí la llamada CONECTA pero queda muda: la señalización va
# por el WebSocket sobre 443 y funciona, el audio no. Es el síntoma más
# confuso posible porque todo lo demás parece correcto.
#
# Con el relay activo, el navegador manda su audio por TCP/443 al
# coturn del stack y coturn se lo entrega a FreeSWITCH por la red
# interna de Docker. No hace falta abrir ningún puerto nuevo.
#
# Vacío = desactivado: solo STUN y audio directo. Sirve en LAN o si el
# firewall deja pasar el rango UDP 16384-16584.
TURN_SECRET=

# Dominio por el que el NAVEGADOR alcanza el relay. Tiene que ser
# DISTINTO de PBX_HOST y con el proxy de Cloudflare APAGADO (nube gris):
# Cloudflare solo reenvía HTTP, y adentro de este TLS viaja TURN, que no
# lo es. Con la nube naranja la conexión se descarta y el audio sigue
# sin funcionar, sin ningún mensaje que lo explique.
#
# En el DNS: registro A a la IP pública del servidor, igual que PBX_HOST
# pero sin proxy. No necesita puerto propio — entra por el mismo 443,
# y Traefik lo separa por SNI (ver deploy/traefik-dynamic.yml.example).
TURN_HOST=

# --- Opcionales ----------------------------------------------------
# Clave con la que se firman los tokens de sesión del panel. Si se deja
# vacía se genera una al azar en cada arranque, lo que cierra la sesión
# de todo el mundo cada vez que se reinicia el backend. Conviene fijarla.
AUTH_SECRET=

# Contraseña del usuario "admin" que se crea solo en la PRIMERA puesta
# en marcha (con la base vacía). Si se deja vacía se genera una y queda
# impresa en el log del backend: `docker compose logs backend | grep -i admin`.
ADMIN_PASSWORD=

# --- Topes de la plataforma (opcionales) ----------------------------
# Disco máximo de grabaciones y de respaldos (GB) y llamadas simultáneas
# máximas en toda la central. Con VARIAS empresas ninguna puede cambiarlos
# desde su panel: los fija quien administra el servidor, aquí. Con una sola
# empresa, sus Ajustes tienen prioridad.
RECORDINGS_MAX_GB=20
BACKUPS_MAX_GB=5
MAX_CONCURRENT_CALLS_GLOBAL=200

# --- Push de voz a la app móvil (ver mobile/SETUP.md) ---------------
# Vacío = desactivado: la app móvil sigue sirviendo para llamar/contestar
# con ella abierta, solo no despierta en segundo plano.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY=
APNS_BUNDLE_ID=
APNS_USE_SANDBOX=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Solo desarrollo o un modelo de IA propio dentro de tu red: permite que la URL
# del modelo (Ajustes) apunte a direcciones privadas. En producción, false.
PERMITIR_URLS_PRIVADAS=false
