# Rutas de NSPBX para un Traefik YA EXISTENTE en el servidor.
#
# Copiar a la carpeta del "file provider" de ese Traefik (la que declara
# en --providers.file.directory), reemplazando el dominio:
#
#   sed -e 's/PBX_HOST/nspbx.tudominio.com/g' \
#       -e 's/TURN_HOST/turn.nspbx.tudominio.com/g' \
#       -e 's/WSS_HOST/sip.tudominio.com/g' \
#       deploy/traefik-dynamic.yml.example \
#     > /etc/dokploy/traefik/dynamic/nspbx.yml
#
# Los dos nombres tienen que coincidir EXACTO con PBX_HOST y TURN_HOST
# del .env: el primero es el que valida Traefik contra la cabecera Host,
# y el segundo el que el navegador pide por SNI al abrir el relay.
#
# Con --providers.file.watch=true lo toma solo, sin reiniciar nada.
#
# ¿Por qué esto y no las labels del docker-compose?
# Las labels dependen del provider de Docker de Traefik. En el servidor
# donde se desplegó, ese provider está roto: Traefik negocia la API del
# demonio en la versión 1.24 y el Docker instalado exige 1.40 como
# mínimo, así que Traefik no ve NINGÚN contenedor y no arma ninguna
# ruta. Con el file provider las rutas están escritas a mano y no
# dependen de esa conexión. Las labels del compose quedan igual: si el
# provider de Docker se arregla, funcionan sin tocar nada.
#
# REQUISITO: Traefik y los contenedores de NSPBX tienen que compartir la
# red `traefik-public`. Los destinos de abajo se resuelven por nombre de
# contenedor, que solo funciona dentro de esa red compartida.
#
# Ojo con FreeSWITCH: compartir la red no alcanza, además tiene que estar
# ESCUCHANDO en ella. Como el contenedor está en dos redes, Traefik
# resuelve nspbx_freeswitch a la IP de traefik-public, y sofia por
# omisión ata sus WebSockets solo a la IP del perfil (la de la red
# interna): el resultado es un 502 que parece de ruteo pero es de
# binding. Por eso ws-binding y wss-binding van en "0.0.0.0" en
# freeswitch/conf/sip_profiles/internal.xml.

http:
  routers:
    # Traefik ordena por longitud de regla, así que estas dos (más
    # específicas) ganan sobre el catch-all del panel.
    nspbx-api:
      rule: "Host(`PBX_HOST`) && (PathPrefix(`/api`) || PathPrefix(`/ws`))"
      entryPoints: ["websecure"]
      service: nspbx-backend
      tls:
        certResolver: mi-resuelves-ssl

    # Softphone del navegador (SIP sobre WebSocket). Apunta al wss de
    # FreeSWITCH (7443) y NO al ws en claro (5066), aunque eso signifique
    # cifrar dos veces. El motivo no es la seguridad sino el protocolo:
    # el navegador habla wss://, así que SIP.js escribe
    # "Via: SIP/2.0/WSS" en cada mensaje. Si Traefik lo entrega por el
    # 5066 —un socket ws en claro—, sofia no encuentra transporte para
    # responder y DESCARTA el mensaje sin decir nada: ni 401, ni error,
    # ni línea en el log. El softphone se queda en "Conectando…" para
    # siempre y no hay ninguna pista de por qué.
    #
    # Comprobado en aislamiento: mismo socket ws, mismo REGISTER, y lo
    # único que cambia es el Via —"SIP/2.0/WS" devuelve 401 y
    # "SIP/2.0/WSS" devuelve silencio—. Contra el 7443 con Via WSS
    # vuelve el 401 normal.
    # OJO: esta ruta ya NO es por donde entra el softphone. Se comprobó que
    # con Traefik en el medio el registro funciona pero NO SE PUEDE LLAMAR
    # al softphone web (ver el puerto 8443 en docker-compose.yml). Hoy el
    # navegador va directo a FreeSWITCH por WSS_HOST:8443. Se deja porque no
    # molesta y sirve de reserva para diagnosticar el registro sin depender
    # del puerto directo.
    nspbx-sip:
      rule: "Host(`PBX_HOST`) && PathPrefix(`/sip`)"
      entryPoints: ["websecure"]
      service: nspbx-freeswitch
      middlewares: ["nspbx-sip-strip"]
      tls:
        certResolver: mi-resuelves-ssl

    # Esta ruta NO la usa nadie: existe solo para que ACME emita y renueve
    # el certificado de WSS_HOST. Ese certificado no lo sirve Traefik sino
    # FreeSWITCH, porque el softphone abre el WebSocket DIRECTO contra él
    # (ver el puerto 8443 en docker-compose.yml: con el proxy en el medio no
    # se puede llamar a un softphone web). Traefik lo renueva en acme.json y
    # scripts/renovar-cert-wss.sh lo copia al wss.pem de FreeSWITCH.
    #
    # WSS_HOST tiene que ser un registro A a la IP pública con el proxy de
    # Cloudflare APAGADO (nube gris), igual que TURN_HOST: el navegador
    # tiene que llegar al origen sin intermediarios.
    nspbx-wsscert:
      rule: "Host(`WSS_HOST`)"
      entryPoints: ["websecure"]
      service: nspbx-frontend
      tls:
        certResolver: mi-resuelves-ssl

    nspbx-panel:
      rule: "Host(`PBX_HOST`)"
      entryPoints: ["websecure"]
      service: nspbx-frontend
      tls:
        certResolver: mi-resuelves-ssl

  middlewares:
    # mod_sofia escucha en el 7443 sin path fijo, así que se le quita el
    # /sip antes de reenviar y la conexión le llega en la raíz.
    nspbx-sip-strip:
      stripPrefix:
        prefixes: ["/sip"]

  services:
    nspbx-frontend:
      loadBalancer:
        servers:
          - url: "http://nspbx_frontend:3000"
    nspbx-backend:
      loadBalancer:
        servers:
          - url: "http://nspbx_backend:8000"
    nspbx-freeswitch:
      loadBalancer:
        serversTransport: nspbx-fs-tls
        servers:
          - url: "https://nspbx_freeswitch:7443"

  serversTransports:

    # FreeSWITCH se autogenera wss.pem y no hay manera de que lo emita
    # una CA pública: el destino es un nombre interno de Docker, no un
    # dominio. Ese certificado lo ve únicamente Traefik, que va por la
    # red interna; el navegador sigue viendo el certificado válido del
    # panel. Por eso saltarse la verificación acá no expone nada.
    nspbx-fs-tls:
      insecureSkipVerify: true

# ----------------------------------------------------------------------
# Relay de audio (TURN). Va en la sección `tcp:` y no en `http:` porque
# TURN no es HTTP: adentro del TLS viaja su propio protocolo binario.
#
# Traefik puede atender los dos en el MISMO 443 porque separa por SNI:
# si el nombre pedido es TURN_HOST, gana este router TCP; para
# cualquier otro sigue mandando el `http:` de arriba. Por eso el relay
# no necesita ningún puerto nuevo abierto en el firewall, que es todo
# el punto: en la red donde se desplegó esto, 443 es lo único que pasa.
#
# En el DNS, TURN_HOST tiene que ser un registro A a la IP pública con
# el proxy de Cloudflare APAGADO (nube gris). Con el proxy naranja,
# Cloudflare solo reenvía HTTP y descarta esta conexión.
tcp:
  routers:
    nspbx-turn:
      rule: "HostSNI(`TURN_HOST`)"
      entryPoints: ["websecure"]
      service: nspbx-coturn
      tls:
        certResolver: mi-resuelves-ssl

  services:
    nspbx-coturn:
      loadBalancer:
        servers:
          # Sin TLS: Traefik ya lo desarmó. coturn escucha TURN en claro
          # en el 3478 y ese puerto no está publicado — solo se llega por
          # la red de Docker.
          - address: "nspbx_coturn:3478"

# NO se publica acá /fs/* (directory, dialplan, cdr): lo consume
# FreeSWITCH por la red interna de Docker y no hay motivo para que sea
# alcanzable desde internet, aunque lleve secreto compartido. Al no
# tener router propio cae en el catch-all del panel y devuelve 404.
#
# El SIP (5060) y el audio (RTP, 16384-16584) TAMPOCO pasan por Traefik:
# son UDP y con un reverse proxy HTTP de por medio el audio se rompe.
# Esos puertos se publican directo desde el contenedor de FreeSWITCH.
