# Jail de fail2ban para FreeSWITCH. Instalación en el servidor (ver README.md):
#
#   sudo cp deploy/fail2ban/filter.d/nspbx-freeswitch.conf /etc/fail2ban/filter.d/
#   sudo cp deploy/fail2ban/jail.d/nspbx-freeswitch.local  /etc/fail2ban/jail.d/
#   sudo systemctl restart fail2ban
#   sudo fail2ban-client status nspbx-freeswitch
#
# Lee el log JSON que Docker guarda de los contenedores. Si usas otro
# logging driver (journald, etc.) cambia `backend`/`logpath` según corresponda.

[nspbx-freeswitch]
enabled  = true
filter   = nspbx-freeswitch
backend  = auto
logpath  = /var/lib/docker/containers/*/*-json.log

# 6 fallos en 10 minutos -> bloqueo de 1 hora. Un teléfono con la contraseña
# mal puesta repite el intento cada pocos segundos, así que un usuario legítimo
# que se equivoca queda bloqueado un rato; es el precio de frenar la fuerza
# bruta. Súbelo si tus clientes reportan bloqueos por error.
maxretry = 6
findtime = 600
bantime  = 3600

# Los puertos de FreeSWITCH están publicados por Docker, así que el tráfico
# NO pasa por la cadena INPUT sino por FORWARD: el bloqueo tiene que ir en
# DOCKER-USER o no surte efecto (fail2ban dice "Ban" y la IP sigue entrando).
port     = 5060,15080
protocol = all
chain    = DOCKER-USER
banaction = iptables-allports
# Direcciones que nunca se bloquean: agrega aquí la IP de tu oficina.
ignoreip = 127.0.0.1/8 ::1
